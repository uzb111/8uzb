{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/content.js": {
      "maxDuration": 60
    }
  },
  "headers": [
    {
      "source": "/(deployment.config.js|storage.js|app.js)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    }
  ]
}
